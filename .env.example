# PostgreSQL administrado con TLS. Sustituya todos los marcadores localmente.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Genere con: openssl rand -base64 48
AUTH_SECRET="replace-with-a-random-secret"

APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="America/Guayaquil"
SESSION_TTL_HOURS="12"
REMEMBER_SESSION_TTL_DAYS="30"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"
DATABASE_POOL_MAX="2"

# Solo para el seed local; no utilice esta contraseña en producción.
SEED_ADMIN_PASSWORD="replace-with-a-local-development-password"
