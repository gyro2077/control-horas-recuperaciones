generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleType {
  INTERN
  FULL_TIME
  CUSTOM
}

enum EntryType {
  SCHEDULED
  CUSTOM
  PERMISSION
}

enum PermissionKind {
  UNIVERSITY
  PERSONAL
  MEDICAL
  ILLNESS
  ABSENCE
  OTHER
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(150)
  email               String     @unique @db.VarChar(255)
  passwordHash        String     @db.VarChar(255)
  role                Role       @default(USER)
  status              UserStatus @default(ACTIVE)
  timezone            String     @default("America/Guayaquil") @db.VarChar(80)
  scheduleId          String?    @db.Uuid
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  schedule     Schedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  dailyEntries DailyEntry[]
  permissions  Permission[]
  sessions     Session[]

  @@index([status, role])
  @@index([scheduleId])
}

model Schedule {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(120)
  type      ScheduleType
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  days  ScheduleDay[]
  users User[]

  @@index([active, type])
}

model ScheduleDay {
  id              String    @id @default(uuid()) @db.Uuid
  scheduleId      String    @db.Uuid
  weekday         Int
  isWorkingDay    Boolean   @default(false)
  startTime       DateTime? @db.Time(0)
  endTime         DateTime? @db.Time(0)
  breakMinutes    Int       @default(0)
  expectedMinutes Int       @default(0)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@index([weekday])
}

model DailyEntry {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  date             DateTime  @db.Date
  scheduledMinutes Int
  startDateTime    DateTime?
  endDateTime      DateTime?
  breakMinutes     Int       @default(0)
  workedMinutes    Int
  balanceMinutes   Int
  type             EntryType
  note             String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission?

  @@unique([userId, date])
  @@index([userId, date])
}

model Permission {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  dailyEntryId    String         @unique @db.Uuid
  date            DateTime       @db.Date
  kind            PermissionKind
  durationMinutes Int
  fullDay         Boolean        @default(false)
  reason          String?        @db.VarChar(500)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyEntry DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuthThrottle {
  keyHash         String    @id @db.VarChar(64)
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
}
